<Window x:Class="Island.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Island · Settings" Width="1020" Height="770" MinWidth="850" MinHeight="620" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="White">
 <Border Background="#F219191D" CornerRadius="16" BorderBrush="#26FFFFFF" BorderThickness="1" Padding="0,42,0,0"><Grid><Grid Background="Transparent" Height="42" VerticalAlignment="Top" Margin="0,-42,0,0" MouseLeftButtonDown="MacTitleDrag"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0"><Button Width="13" Height="13" Padding="0" Background="#FF6059" Click="MacClose" ToolTip="Close settings"/><Button Width="13" Height="13" Padding="0" Background="#FFBD2E" Margin="8,0,0,0" Click="MacMinimize" ToolTip="Minimize"/><Button Width="13" Height="13" Padding="0" Background="#28C840" Margin="8,0,0,0" Click="MacZoom" ToolTip="Zoom window"/><TextBlock Text="Island Settings" Foreground="#9797A6" FontSize="12" Margin="18,0,0,0"/></StackPanel></Grid><Grid Background="Transparent">
  <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#202024" BorderBrush="#303035" BorderThickness="0,0,1,0" CornerRadius="0,0,0,15">
   <DockPanel Margin="18,28,18,20">
    <StackPanel DockPanel.Dock="Top" Margin="14,0,0,30"><StackPanel Orientation="Horizontal"><Border Background="#070709" Width="32" Height="32" CornerRadius="10"><TextBlock Text="◈" Foreground="{DynamicResource Accent}" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Island" FontSize="25" FontWeight="SemiBold" Margin="11,0,0,0"/></StackPanel><TextBlock Text="A little space for everything." Foreground="#888891" FontSize="11" Margin="0,10,0,0"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="MADE FOR WINDOWS" Foreground="#60606B" FontSize="9" Margin="14,0,0,10"/><Button Content="Open your island  ↗" Click="OpenClick" Background="#2E3533" Foreground="{DynamicResource Accent}"/></StackPanel>
    <StackPanel x:Name="Navigation"/>
   </DockPanel>
  </Border>
  <DockPanel Grid.Column="1" Margin="36,28,36,24">
   <StackPanel DockPanel.Dock="Top"><TextBlock x:Name="SectionTitle" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="SectionSubtitle" Foreground="#9696A1" FontSize="13" Margin="0,8,0,20" TextWrapping="Wrap"/></StackPanel>
   <TextBlock DockPanel.Dock="Bottom" Text="Changes save automatically. Your island updates instantly." Foreground="#666670" FontSize="11" Margin="0,16,0,0"/>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ContentPanel" Margin="0,0,12,0"/></ScrollViewer>
  </DockPanel>
 </Grid>
</Grid></Border></Window>
